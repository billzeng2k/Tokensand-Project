# Generated local database password is stored in .env by scripts/setup.py.
SINGLESTORE_ROOT_PASSWORD=
SINGLESTORE_HOST=127.0.0.1
SINGLESTORE_PORT=3307
SINGLESTORE_DATABASE=tokensand
# Both analytics integrations default to offline development.
AMPLITUDE_MODE=local
AMPLITUDE_API_KEY=
STATSIG_MODE=local
STATSIG_SERVER_SECRET=
# Optional routes supplied by Firedrill. Empty means explicit local fixtures.
CALENDAR_INVOKE_URL=
SHOPPING_INVOKE_URL=
# Agent provider. Demo mode makes no LLM requests. Live mode requires a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
# Optional current pricing inputs; leave blank to show cost as unknown.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_WEB_SEARCH_USD_PER_CALL=
# Optional admin password/token. Empty: generate a private local admin token.
# Never expose this local server publicly. Set a long random value for admin sign-in.
UPNEXT_ADMIN_TOKEN=

# Google WEB application OAuth client (not a Desktop client).
# Or save Google's downloaded Web client JSON as .local/google-web-client.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact callback in Google: http://localhost:8787/auth/google/callback
UPNEXT_APP_URL=http://localhost:8787
# Optional Fernet key. Empty: generate owner-only .local/token-encryption.key.
# Keep the same key across restarts; losing it requires reconnecting calendars.
UPNEXT_TOKEN_ENCRYPTION_KEY=

# Local inference (no OpenAI calls). Use npm run amazon:install for the local browser worker.
UPNEXT_LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:14b
AMAZON_RETRIEVAL=local-browser
